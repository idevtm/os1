  "conclusions": {
    "desktop": "Confirmed shared event-ring overflow. No removal, closure, malformed reply, or transport-call error during observation. Logitech stays configured.",
    "laptop": "Confirmed EHCI periodic split ERR with halted=1, CERR=0, remaining=4, token=0x80040141 on two input identities. Driver retires each identity; original observation reports removal then closure. Touchpad has no input failure.",
    "shared_latency": "Normal native-input polling remains traced. Automatic persistence runs synchronously before request dispatch and holds global syscall admission. Logs show second-scale input-call delays. This is a strong contributor hypothesis, not a timed attribution of each delay to export.",
    "limits": "Exact cause of EHCI downstream ERR remains unknown. Scheduling/rearm and TT behavior need investigation and bounded recovery. Do not combine coarse IPC times with measurement-clock EHCI timestamps. Lost counters count global records and overlap across subscriptions."
  },
  "analysis_scope": "Read-only hardware evidence and source analysis. No source changes, image writes, or kernel builds. Runtime test execution is not required for this analysis.",
  "sources": {
    "ehci_spec": "https://www.intel.com/content/dam/www/public/us/en/documents/technical-specifications/ehci-specification-for-usb.pdf (Table3-16; section4.12.2.4.2)",
    "normal_log_policy": "src/kernel/debug/log.cpp:355",
    "export_worker": "src/kernel/ipc/channel.cpp:1646",
    "syscall_admission": "src/kernel/core/trap_dispatch.cpp:24",
    "input_loss": "src/kernel/drivers/input/service.cpp:194",
    "ehci_retirement": "src/kernel/drivers/usb/ehci.cpp:573"
  },
